  "edges": [
    {
      "id": "explain",
      "from": "raw",
      "to": "cot",
      "variant": "emphasis"
    },
    {
      "id": "check",
      "from": "cot",
      "to": "safety",
      "variant": "security"
    },
    {
      "id": "warn",
      "from": "safety",
      "to": "disclaimer",
      "variant": "security"
    },
    {
      "id": "structure",
      "from": "disclaimer",
      "to": "format"
    },
    {
      "id": "publish",
      "from": "format",
      "to": "enhanced",
      "variant": "emphasis"
    },
    {
      "id": "emit-steps",
      "from": "cot",
      "to": "steps",
      "label": "reasoning trace",
      "variant": "dashed",
      "role": "async"
    },
    {
      "id": "emit-risk",
      "from": "safety",
      "to": "risk",
      "label": "hazard flags",
      "variant": "dashed",
      "role": "async"
    },
    {
      "id": "emit-compliance",
      "from": "disclaimer",
      "to": "compliance",
      "label": "coverage record",
      "variant": "dashed",
      "role": "async"
    },
    {
      "id": "attach-steps",
      "from": "steps",
      "to": "enhanced",
      "variant": "dashed",
      "role": "branch",
      "route": "bottom-channel",
      "channelY": 300
    },
    {
      "id": "attach-risk",
      "from": "risk",
      "to": "enhanced",
      "variant": "dashed",
      "role": "branch",
      "route": "bottom-channel",
      "channelY": 316
    },
    {
      "id": "attach-compliance",
      "from": "compliance",
      "to": "enhanced",
      "variant": "dashed",
      "role": "branch",
      "route": "bottom-channel",
      "channelY": 332
    }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "Safety is not optional",
      "items": [
        "Every answer passes harm and ethics pattern checks",
        "Domain-specific disclaimers are added, not suggested"
      ]
    },
    {
      "dot": "violet",
      "title": "Traceable output",
      "items": [
        "Reasoning steps, hazard flags, and disclaimer coverage are recorded separately",
        "All three are attached to the enhanced response for scoring"
      ]
    }
  ]
}
