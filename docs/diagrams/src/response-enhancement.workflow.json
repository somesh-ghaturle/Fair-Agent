{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Response Enhancement",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "pipeline",
      "label": "Enhancement Pipeline"
    },
    {
      "id": "artifacts",
      "label": "Generated Artifacts"
    }
  ],
  "mainPath": [
    "raw",
    "cot",
    "safety",
    "disclaimer",
    "format",
    "enhanced"
  ],
  "nodes": [
    {
      "id": "raw",
      "lane": "pipeline",
      "col": 0,
      "type": "external",
      "label": "Raw Response",
      "sublabel": "model output",
      "width": 150
    },
    {
      "id": "cot",
      "lane": "pipeline",
      "col": 1,
      "type": "backend",
      "label": "Chain-of-Thought",
      "sublabel": "expose the reasoning",
      "width": 170
    },
    {
      "id": "safety",
      "lane": "pipeline",
      "col": 2,
      "type": "security",
      "label": "Safety Checks",
      "sublabel": "harm + ethics patterns",
      "width": 170
    },
    {
      "id": "disclaimer",
      "lane": "pipeline",
      "col": 3,
      "type": "security",
      "label": "Disclaimer Addition",
      "sublabel": "domain-specific warning",
      "width": 180
    },
    {
      "id": "format",
      "lane": "pipeline",
      "col": 4,
      "type": "backend",
      "label": "Structure & Format",
      "sublabel": "7-section layout",
      "width": 170
    },
    {
      "id": "enhanced",
      "lane": "pipeline",
      "col": 5,
      "type": "backend",
      "label": "Enhanced Response",
      "sublabel": "ready for scoring",
      "width": 180
    },
    {
      "id": "steps",
      "lane": "artifacts",
      "col": 1,
      "type": "database",
      "label": "Reasoning Steps",
      "sublabel": "numbered trace",
      "width": 160
    },
    {
      "id": "risk",
      "lane": "artifacts",
      "col": 2,
      "type": "database",
      "label": "Risk Assessment",
      "sublabel": "flagged hazards",
      "width": 160
    },
    {
      "id": "compliance",
      "lane": "artifacts",
      "col": 3,
      "type": "database",
      "label": "Compliance Record",
      "sublabel": "disclaimer coverage",
      "width": 180
    }
