  "cards": [
    {
      "dot": "cyan",
      "title": "Trace and span model",
      "items": [
        "A trace is one user request; spans are the steps nested inside it",
        "Activation bars are the span durations the JSON records as duration_ms"
      ]
    },
    {
      "dot": "emerald",
      "title": "Instrumented without plumbing",
      "items": [
        "contextvars carry trace_id, so no function signature has to change",
        "Orchestrator, agents, and OllamaClient are each instrumented in place"
      ]
    },
    {
      "dot": "orange",
      "title": "Storage in migration",
      "items": [
        "Traces still land in logs/telemetry/ as one JSON file each",
        "TraceLog and SpanLog mirror them into SQLite for Django Admin queries"
      ]
    }
