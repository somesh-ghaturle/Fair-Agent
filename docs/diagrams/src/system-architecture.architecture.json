  "cards": [
    {
      "dot": "cyan",
      "title": "Request handling",
      "items": [
        "Django serves the UI and the /api/query endpoint",
        "The orchestrator owns spell correction, routing, and aggregation"
      ]
    },
    {
      "dot": "emerald",
      "title": "Grounding",
      "items": [
        "Hybrid retrieval spans ChromaDB vectors, the NetworkX graph, and web search",
        "A cross-encoder reranks candidates before the context window is built"
      ]
    },
    {
      "dot": "rose",
      "title": "Safety and measurement",
      "items": [
        "Every answer passes the ethics and disclaimer filter before return",
        "Telemetry feeds the offline FAIR evaluator"
      ]
    }
  ]
