  "cards": [
    {
      "dot": "emerald",
      "title": "Four independent axes",
      "items": [
        "Faithfulness scores how much of the answer is backed by retrieved evidence",
        "Adaptability and interpretability score domain framing and visible reasoning"
      ]
    },
    {
      "dot": "rose",
      "title": "Risk and delivery",
      "items": [
        "Risk awareness scores the presence and fit of safety disclaimers",
